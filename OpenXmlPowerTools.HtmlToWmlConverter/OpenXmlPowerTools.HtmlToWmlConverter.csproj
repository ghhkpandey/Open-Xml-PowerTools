<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net481;net10.0</TargetFrameworks>
    <RootNamespace>OpenXmlPowerTools</RootNamespace>
    <AssemblyName>OpenXmlPowerTools.HtmlToWmlConverter</AssemblyName>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net481'">
    <Reference Include="WindowsBase" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="System.Drawing.Common" Version="10.0.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenXmlPowerTools.Core\OpenXmlPowerTools.Core.csproj" />
    <ProjectReference Include="..\OpenXmlPowerTools.RevisionAccepter\OpenXmlPowerTools.RevisionAccepter.csproj" />
    <ProjectReference Include="..\OpenXmlPowerTools.MetricsGetter\OpenXmlPowerTools.MetricsGetter.csproj" />
    <ProjectReference Include="..\OpenXmlPowerTools.WmlToHtmlConverter\OpenXmlPowerTools.WmlToHtmlConverter.csproj" />
  </ItemGroup>

</Project>
