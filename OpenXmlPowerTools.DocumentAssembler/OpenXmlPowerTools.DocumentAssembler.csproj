<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net481;net10.0</TargetFrameworks>
    <RootNamespace>OpenXmlPowerTools</RootNamespace>
    <AssemblyName>OpenXmlPowerTools.DocumentAssembler</AssemblyName>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net481'">
    <Reference Include="WindowsBase" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenXmlPowerTools.Core\OpenXmlPowerTools.Core.csproj" />
    <ProjectReference Include="..\OpenXmlPowerTools.OpenXmlRegex\OpenXmlPowerTools.OpenXmlRegex.csproj" />
    <ProjectReference Include="..\OpenXmlPowerTools.RevisionAccepter\OpenXmlPowerTools.RevisionAccepter.csproj" />
  </ItemGroup>

</Project>
